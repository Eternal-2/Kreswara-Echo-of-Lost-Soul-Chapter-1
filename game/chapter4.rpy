    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Ini pertarungan terakhir. Aku tidak akan mundur sekarang."
    hide k_angrytalk


label soal_ch4_1:
    show screen soal_panel(
        nomor="1",
        tema="Python – String & List",
        kode="kalimat = 'Belajar Python Itu Seru'\nkata = kalimat.split()\nprint(len(kata))\nprint(kata[0].upper())",
        pertanyaan="Apa output dari kode di atas?"
    )

    menu:
        "3 dan BELAJAR":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "Bukan 3! split() memecah SEMUA kata—ada 4!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "Hitung lagi kata-kata di kalimat itu, Wara. Coba soal cadangan dulu!"
            hide a_talk
            jump cadangan_ch4_1

        "3 dan belajar":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "Salah dua-duanya! Jumlah kata bukan 3, dan .upper() mengubah ke HURUF BESAR!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "split() itu memecah per spasi, dan upper() membuat semua huruf kapital!"
            hide a_talk
            jump cadangan_ch4_1

        "4 dan BELAJAR":
            hide screen soal_panel
            $ fase1_benar += 1
            $ quiz_score  += 1
            show screen feedback_screen("berhasil")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), getar with dissolve
            k "4 kata! Dan kata[0].upper() = BELAJAR!"
            k "Sekarang RASAKAN INI!"
            hide k_angrytalk
            play sound "audio/sfx/chapter 4/monster.mp3"
            show dur_talk at Position(xalign=0.5, yalign=0.3), getar with dissolve
            dur "GUH!?! Tidak mungkin kau tahu itu...!"
            hide dur_talk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "Bagus! split() menghasilkan 4 elemen, kata[0]='Belajar', .upper()='BELAJAR'!"
            a "Serangan pertama mengenai!"
            hide a_talk

        "4 dan Belajar":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "Jumlah katanya benar 4, tapi .upper() mengubah ke HURUF KAPITAL SEMUA!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a ".upper() bukan .capitalize()! Hasilnya BELAJAR bukan Belajar!"
            hide a_talk
            jump cadangan_ch4_1

label cadangan_ch4_1:
    show screen soal_panel(
        nomor="1C",
        tema="Python – Kondisional",
        kode="nilai = 50\nif nilai >= 60:\n    print('Lulus')\nelse:\n    print('Tidak Lulus')",
        pertanyaan="Apa output dari program tersebut?"
    )

    menu:
        "Lulus":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "50 >= 60 itu FALSE! Blok if tidak dijalankan, yang jalan blok else!"
