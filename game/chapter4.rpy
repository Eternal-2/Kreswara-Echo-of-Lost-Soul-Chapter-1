    k "bahkan manusia satu dan yang lainnya pun tidak paham sepenuhnya."
    k "Namun itulah yang menjadi menarik..."
    k "Kita bisa memahami emosi manusia lainnya dengan menjalin hubungan"
    k "ataupun komunikasi dengan manusia tersebut."
    hide k_talk

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Aku pun tidak tahu kenapa, ada manusia yang mau melindungi mati-matian seorang kecerdasan buatan"
    a "yang bahkan jika tidak diberi perintah maka dia tidak akan melakukan apapun."
    hide a_talk

    show k_think at Position(xalign=0.5, yalign=0.3) with dissolve
    k "AS-LEEN..."
    k "Apakah kau percaya bahwa seorang manusia akan mengadopsi beberapa kebiasaan"
    k "yang dimiliki oleh orang yang mereka sayang?"
    hide k_think

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Iya, aku percaya akan hal itu."
    a "Namun diriku pribadi tak tahu rasanya mengalami itu."
    hide a_talk

    show k_smile at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Apakah kamu benar-benar merasakan apa yang aku rasakan?"
    k "Bukan sebagai AI ataupun karena semua kejadian ini,"
    k "melainkan karena sejak awal mata kita bertemu."
    k "Bagaimana saat tatapan kita seolah menahan waktu hanya untuk saling memandang,"
    k "sembari perlahan-lahan mengingat bentuk wajah masing-masing?"
    hide k_smile

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "I-iya, aku juga."
    hide a_talk

    show k_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Kalau sudah begitu ya tidak apa-apa..."
    k "Itu berarti sejauh apapun kita berpisah, selama apapun kita tidak bertukar kata,"
    k "diri kita sudah terpatri di jiwa masing-masing,"
    k "layaknya sudah menjadi kehidupan tersendiri, lalu bernapas dengan esensi kehidupan kita bersama."
    hide k_talk

    nr "Setelah berbicara seperti itu, semangat wara pun akhirnya membara, dia tiba tiba mengambil posisi peregangan sehingga as-leen pun kebingungan"

    show a_talk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
    a "Apa yang sedang kau lakukan, Wara?"
    hide a_talk

    show k_smile at Position(xalign=0.5, yalign=0.3) with dissolve
    k "(Sambil berbalik)\nAku sedang mempersiapkan untuk melawan boss selanjutnya...."
    hide k_smile

    nr "AS-LEEN yang merasa itu adalah hal yang mengejutkan, akhirnya tertawa."
    nr "Suara lembut, anggun, dan kaku yang selama ini melekat padanya"
    nr "kini berubah menjadi suara tawa bahagia karena ulah seorang pria."

    play sound "audio/sfx/chapter 4/freesound_community-girl-laugh-6689.mp3"

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "HAHAHAHAHAHA. Kamu sangat lucu, Wara."
    hide a_talk

    nr "Mendengar tawa itu, hati Wara seolah diikat oleh tali yang begitu kencang"
    nr "tali yang hanya mengikat hatinya agar terus mengingat satu sosok, yaitu AS-LEEN."

    show k_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Ayo kita pergi sekarang."
    hide k_talk

    play sound "audio/sfx/chapter 4/Walking on the stone-yoyosound.com.mp3"

    scene bg_desa_replika with dissolve
    
    play music "audio/backsound/Chapter 4/desa_replika.mp3" fadein 1.5

    nr "Wara memegang erat jari-jemari AS-LEEN. Mereka tiba di sebuah desa."
    nr "Desa yang mereka temui ini sangat familiar namun dengan suasana gelap di tiap sudutnya."
    nr "Terdapat beberapa glitch di beberapa tempatnya."

    stop sound
    play sound "audio/sfx/chapter 4/8.suara Sudden dark pulse1.mp3" loop
    
    
    scene bg_desa_replikawara with dissolve
    
    k "Apakah ini desaku? Tapi kenapa suasananya suram seperti ini?"
    
    a "Tidak... ini hanya replika."

    nr "Kreswara dan AS-LEEN berjalan beriringan hingga menyadari bangunan besar"
    nr "menyerupai istana kerajaan zaman dahulu yang megah di arah utara desa."
    nr "Suasana di sekitarnya terasa begitu menyeramkan dan membuat waswas."

    play sound "audio/sfx/chapter 4/soundreality-thunder-sound-375727.mp3"

    a "Wara, hati-hati ada data roh yang menghadang."
        
    k "Santai aja. Hitung-hitung pemanasan kan."

    stop sound

    scene bg_desa_replika with dissolve

    nr "── Sesi Pertarungan Data Roh ──"
    nr "Pertarungan berlalu begitu saja. Beberapa rintangan muncul di berbagai sudut,"
    nr "tetapi hal itu tidak membuat Kreswara dan AS-LEEN menyerah."

    nr "Perjalanan terhenti sebentar ketika AS-LEEN tampak penasaran terhadap struktur"
    nr "Bangunan di sekitarnya bagaimana kaki telanjangnya menginjak tekstur tanah,"
    nr "bagaimana hidungnya bisa merasakan dinginnya udara, dan bagaimana untuk pertama kalinya"
    nr "telinganya mendengar suara jangkrik malam secara langsung, bukan melalui data."

    stop music
    play sound "audio/sfx/chapter 4/1.suara jangkrik.mp3" loop

    show k_smile at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Kayaknya asyik tuh. Bagaimana rasanya?"
    k "Maksudku, bagaimana rasanya mencoba berbaur dengan kehidupan, AS-LEEN?"
    hide k_smile

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Rasanya cukup aneh. Aneh yang menenangkan maksudku."
    a "Dan... sedikit gatal kakiku saat menyentuh tanah."
    hide a_talk

    show k_smile at Position(xalign=0.5, yalign=0.3), napas_berat with dissolve
    k "(Tersenyum melihat AS-LEEN merasakan hal baru untuk pertama kalinya)"
    hide k_smile

    stop sound
    play sound "audio/sfx/chapter 4/soundreality-thunder-sound-375727.mp3" loop

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Wara, kita harus segera menyelesaikan ini."
    a "Makin lama kelamaan ada pergerakan asing yang aku deteksi di sini."
    a "Dunia ini sepertinya perlahan mulai rusak untuk memasuki data di dunia nyata."
    hide a_talk

    stop sound
    stop music
    
    play music "audio/sfx/chapter 4/sarthakraj_308-heavy-wind-storm-326096.mp3" loop
    play sound "audio/sfx/chapter 4/morganfilm-walking-on-stone-beach-168152 2.mp3" loop

    nr "Mereka segera bergegas menuju bangunan itu, berusaha tetap bersama"
    
    stop music
    stop sound

    play sound "audio/sfx/chapter 4/8.suara Sudden dark pulse.mp3" loop
    scene bg_gelut with dissolve 
    
    k "..."
    k "tchh..."
    
    nr "dan menghindari sambaran guntur dari langit."
    nr "Akhirnya mereka sampai setelah menaiki tangga yang cukup panjang."


label pertemuan_duryodana:
    scene bg_duryodana with dissolve      

    nr "Di sana, sudah ada seorang lelaki bertubuh tegap dan gagah yang menunggu mereka"
    nr "sambil duduk di kursi singgasana."
    nr "Segala hal di sekelilingnya mencerminkan kemewahan entah dari hartanya"
    nr "ataupun kesombongannya yang seolah mampu membelah langit."
    nr "Perlahan, tubuhnya meninggalkan singgasana untuk menghadapi Kreswara dan AS-LEEN."

    stop sound
    play sound "audio/sfx/chapter 4/9.suara Tension Rise.mp3" loop
    
    scene bg_kerajaan with dissolve
    
    show a_talk at Position(xalign=0.5, yalign=0.3), getar with dissolve
    a "Duryodana."
    hide a_talk

    stop sound
    play music "audio/backsound/Chapter 4/surprising_media-spatial-fantasy-455240.mp3" loop

    show dur_talk at Position(xalign=0.5, yalign=0.3), napas_berat with dissolve
    dur "Sudah menjadi kewajiban bagi makhluk fana seperti kalian"
    dur "untuk mengingat kisah kemegahan yang tertanam dalam namaku yang agung."
    dur "Dan merupakan sebuah kenistaan bagi kalian yang berani memiliki nyali"
    dur "untuk menatapku dengan mata rapuh penuh tantangan seperti itu."
    dur "Namun, jangan khawatir. Tatapan itu masih bisa kalian simpan dengan bangga"
    dur "tentu saja di bawah kakiku, agar kalian dapat menyaksikan kekuasaanku"
    dur "membentangkan suaranya hingga ke dunia yang berada di balik tempat ini."
    hide dur_talk

    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "J-jadi kau ingin menghancurkan dunia nyata juga?!"
    hide k_angrytalk

    show dur_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    dur "Menghancurkan adalah kata yang terlalu kasar, terlalu vulgar bagi kekuasaanku."
    dur "Aku lebih menyukai kata... pemimpin."
    dur "Ya, pemimpin. Sebuah sebutan yang selalu cocok untuk diriku yang hebat ini."
    dur "Tak sia-sia adikku memberiku informasi tentang dunia yang lebih luas."
    dur "Sayangnya, dia harus berakhir di tangan kotor kalian."
    dur "Namun tidak perlu khawatir kekalahan kalian akan menjadi saksi atas dendamnya."
    dur "Hanya orang-orang tak tahu diri seperti musuh-musuhku terdahulu"
    dur "yang selalu berusaha menghalangiku, orang berlima tak tahu diri itu."
    hide dur_talk

    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Kepemimpinanmu hanya akan berakhir di tanganku"
    k "Dihancurkan dan dirobek seperti kertas tak berdaya!"
    hide k_angrytalk

    show dur_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    dur "Lancang juga kau."
    hide dur_talk
    
    $ _skipping = False
    show screen radar_roh_screen(level=4)
    $ renpy.pause(2.0, hard=True)
    $ _skipping = True

    $ _skipping = False
    show screen state_roh_screen("WASPADA")
    $ renpy.pause(2.0, hard=True)
    $ _skipping = True


