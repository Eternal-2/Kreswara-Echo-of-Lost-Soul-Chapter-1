    play sound "audio/sfx/chapter 4/1.suara Gentle Wind.mp3" loop
    play sound "audio/sfx/chapter 4/morganfilm-walking-on-stone-beach-168152 2.mp3" loop 
    
    nr "Kreswara dan AS-LEEN kini melanjutkan perjalanannya setelah semua yang terjadi"
 
