    nr "Layaknya saat Wara disambut suara ibunya untuk pulang."
    nr "Layaknya mimpi-mimpinya yang terus ditenggelamkan."
    nr "Layaknya dirinya sendiri yang tak pernah menyerah, apapun yang terjadi."

    k "(Memandang langit sore virtual, meresapi hangatnya)"

    nr "Perlahan-lahan, beberapa rumah dan bangunan mulai menghapus dirinya sendiri"
    nr "layaknya program yang akan ditutup."
    nr "Melihat hal itu, pikiran Kreswara langsung tertuju pada AS-LEEN."
    
    scene bg_peluk with dissolve

    nr "Saat Kreswara baru saja berbalik, tiba-tiba AS-LEEN langsung memeluk tubuhnya,"
    nr "sementara tubuh gadis itu perlahan-lahan mulai terhapus juga."

    scene bg_langit_jingga_pisah with dissolve
    a "Semua pengetahuan yang kumiliki selama ini sebagai AI canggih"
    a "pada akhirnya tidak berguna untuk melawan takdir perpisahan."
    a "Memang memalukan."
    a "Namun, aku tetap berterima kasih atas kesempatan yang telah kamu berikan selama ini."
    a "Sebuah kesempatan untuk melihat seluruh keindahan tentang bagaimana rasanya menjadi manusia melalui dirimu."
    a "Sesuatu yang sebelumnya tidak pernah bisa kurasakan."
    a "Sebuah kesempatan yang bahkan tidak dapat dirasakan oleh AI mana pun di dunia ini."
    a "Aku, AS-LEEN, sangat bahagia bisa merasakan dan melihat semua itu."

    a "Dan aku yakin kamu bisa menggapai mimpimu."
    a "Kamu bisa melakukan hal-hal besar, hal-hal baik lainnya"
    a "Aku mengatakan ini bukan sebagai AI yang mengetahui segalanya,"
    a "melainkan sebagai seseorang yang paling dekat denganmu."
    a "Seseorang yang paling kamu ingat. Seseorang yang paling berarti bagimu,"
    a "bukan?"

    k "Aku juga berterima kasih."
    k "Dan aku berjanji, meskipun akhir seperti apapun menghampiri kita nanti,"
    k "aku akan mengabadikan dirimu selama kakiku masih menginjak bumi ini."
    k "Kisah kita akan terus abadi dan hidup, baik dalam bentuk apapun yang akan kubuat nanti"
    k "maupun dalam hati orang-orang yang mengetahui kisah kita."
    stop music fadeout 2.0
    
    play music "audio/backsound/Chapter 4/vanguardiacreate-the-final-countdown-250335 (1).mp3" fadein 1.5

    nr "Di tengah keheningan virtual yang perlahan memudar,"
    nr "Kreswara merasakan satu tarikan terakhir dari dunia ini."
    nr "Sebuah pilihan yang tidak pernah ada dalam skenario mana pun."
    nr "Pilihan yang hanya bisa dijawab oleh dirinya sendiri."
    
    nr "Langit jingga virtual itu terasa begitu nyata terlalu nyata."
    nr "Dan di ujung kesadaran itu, suara AS-LEEN terdengar untuk terakhir kalinya."

    a "Kreswara… ini saatnya kamu memilih."
    a "Dunia virtual ini bisa kupersiapkan selamanya untukmu."
    a "Tanpa rasa sakit. Tanpa kehilangan. Tanpa ketidakpastian."
    a "Atau… kamu kembali. Ke dunia nyata. Ke orang-orang yang menunggumu."
    a "Pilihan ada di tanganmu."

    stop music fadeout 1.5
    pause 1.0

    call screen pilihan_ending_screen()

    if _return == "good":
        jump dialog_sebelum_good_ending
    else:
        jump dialog_sebelum_bad_ending


label dialog_sebelum_good_ending:

    scene bg_perpisahan with Dissolve(1.5)
    play music "audio/backsound/Chapter 4/vanguardiacreate-the-final-countdown-250335 (1).mp3" fadein 2.0

    nr "AS-LEEN menatap Kreswara untuk terakhir kalinya sebelum semuanya memudar."

    a "Aku pun sebenarnya dari awal kita bertemu sudah merasakan hal yang sama wara—"
    a "bagaimana mata kita selalu menemukan diri kita dalam semua perjalanan ini,"
    a "tangan kita yang saling menggenggam menyalurkan rasa aman dan nyaman"
    a "setiap detik berbahaya yang berusaha memisahkan kita."
    a "Namun, perpisahan ini seperti tidak ada artinya sekarang,"
    a "karena semua arti kata yang ada didalam jiwamu—sekarang terpatri dalam semua data ku."
    a "Aku ingin mengingat mu selamanya karena aku ingin menjadi kasihmu."

    stop music fadeout 2.0
    scene black with Dissolve(2.0)
    pause 1.0

    jump ending_good


label dialog_sebelum_bad_ending:

    scene bg_perpisahan with Dissolve(1.5)
    play music "audio/backsound/ending/bad_ending_ambient.mp3" fadein 2.0

    nr "AS-LEEN memandang wajah Wara untuk terakhir kalinya."

    a "Pada akhirnya, meskipun kita saling menguatkan perpisahan selalu datang ya."
    a "Semua kata kata yang kita ucapkan sebelumnya memang manis,"
    a "namun faktanya wajahmu sudah terlihat buram di penglihatan ku—"
    a "tapi setidaknya diriku akan selalu berusaha mengingatnya."
    a "Meskipun untuk terakhir kalinya."

    stop music fadeout 2.0
    scene black with Dissolve(2.0)
    pause 1.0

    jump ending_bad


label waktu_habis_boss_dur:
    hide screen timer_screen
    hide screen radar_roh_screen
    hide screen state_roh_screen
    hide screen soal_panel
    $ renpy.block_rollback()

    call screen kalah_boss_screen()

    if _return == "restart":
        jump boss_duryodana_dejavu
    else:
        $ renpy.full_restart()


label boss_duryodana_dejavu:
    stop music fadeout 1.5
    stop sound fadeout 1.0

    scene black with Dissolve(1.5)
    pause 1.0

    play sound "audio/sfx/chapter 4/8.suara glitch digital.mp3"
    pause 1.5

    scene bg_kerajaan with Dissolve(2.0)
    play music "audio/backsound/Chapter 4/surprising_media-spatial-fantasy-455240.mp3" fadein 1.5

    nr "Semuanya kembali berputar."
    nr "Seperti kaset yang dipaksa mundur — suara, cahaya, dan udara semuanya terasa familiar."

    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "...Ini..."
    k "Aku pernah merasakan ini sebelumnya."
    k "Tempat ini... suara ini..."
    k "(Memandang sekeliling dengan ekspresi bingung)"
    k "Kita sudah pernah ada di sini."
    hide k_angrytalk

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "...?"
    a "Wara, apa yang kamu maksud?"
    a "Data lokasi kita menunjukkan kita baru saja tiba di area ini."
    a "Tidak ada catatan pergerakan sebelumnya dalam log-ku."
    a "..."
    a "Tapi... kenapa ada anomali di sistem sensorku?"
    a "Seperti ada fragmen memori yang terhapus secara paksa."
    hide a_talk

    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Percayalah padaku, AS-LEEN."
    k "Kita sudah pernah berhadapan dengannya."
    k "Dan kita tahu cara mengalahkannya."
    hide k_angrytalk

    play sound "audio/sfx/chapter 4/9.suara Tension Rise.mp3" loop

    show dur_talk at Position(xalign=0.5, yalign=0.3), napas_berat with dissolve
    dur "Hahaha..."
    dur "HAHAHAHA!"
    dur "Luar biasa. Luar biasa sekali."
    dur "Jadi kau masih bisa merasakan bekas jejakmu sendiri, hah?"
    dur "Sungguh menggelikan."
    hide dur_talk

    show dur_talk at Position(xalign=0.5, yalign=0.3), getar with dissolve
    dur "Tapi apa artinya itu?"
    dur "Kau kembali. Ke sini. Ke hadapanku."
    dur "Dan hasilnya tetap akan sama — kau akan berlutut lagi di hadapan Duryodana!"
    hide dur_talk

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "..."
    a "Wara."
    a "Aku sekarang mengerti maksudmu."
    a "Sistem memori lokalku memang dihapus —"
    a "tapi kamu menyimpan semuanya."
    a "Jadi kita gunakan itu. Sekarang."
    hide a_talk

    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Kali ini kita tidak akan membuat kesalahan yang sama."
    k "Bersiaplah, Duryodana."
    hide k_angrytalk

    stop sound
    show screen radar_roh_screen(level=4)
    pause 1.5
    show screen state_roh_screen("WASPADA")
    pause 1.5

    jump boss_duryodana_start
