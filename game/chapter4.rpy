    k "yang dimiliki oleh orang yang mereka sayang?"
    hide k_think

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Iya, aku percaya akan hal itu."
    a "Namun diriku pribadi tak tahu rasanya mengalami itu."
