    k "Maksudku, bagaimana rasanya mencoba berbaur dengan kehidupan, AS-LEEN?"
    hide k_smile

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Rasanya cukup aneh. Aneh yang menenangkan maksudku."
    a "Dan... sedikit gatal kakiku saat menyentuh tanah."
    hide a_talk

    show k_smile at Position(xalign=0.5, yalign=0.3), napas_berat with dissolve
    k "(Tersenyum melihat AS-LEEN merasakan hal baru untuk pertama kalinya)"
    hide k_smile

    stop sound
    play sound "audio/sfx/chapter 4/soundreality-thunder-sound-375727.mp3" loop

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Wara, kita harus segera menyelesaikan ini."
    a "Makin lama kelamaan ada pergerakan asing yang aku deteksi di sini."
    a "Dunia ini sepertinya perlahan mulai rusak untuk memasuki data di dunia nyata."
    hide a_talk

    stop sound
    stop music
    
    play music "audio/sfx/chapter 4/sarthakraj_308-heavy-wind-storm-326096.mp3" loop
    play sound "audio/sfx/chapter 4/morganfilm-walking-on-stone-beach-168152 2.mp3" loop

    nr "Mereka segera bergegas menuju bangunan itu, berusaha tetap bersama"
    
    stop music
    stop sound

    play sound "audio/sfx/chapter 4/8.suara Sudden dark pulse.mp3" loop
    scene bg_gelut with dissolve 
    
    k "..."
    k "tchh..."
    
    nr "dan menghindari sambaran guntur dari langit."
    nr "Akhirnya mereka sampai setelah menaiki tangga yang cukup panjang."


label pertemuan_duryodana:
    scene bg_duryodana with dissolve      

    nr "Di sana, sudah ada seorang lelaki bertubuh tegap dan gagah yang menunggu mereka"
    nr "sambil duduk di kursi singgasana."
    nr "Segala hal di sekelilingnya mencerminkan kemewahan entah dari hartanya"
    nr "ataupun kesombongannya yang seolah mampu membelah langit."
    nr "Perlahan, tubuhnya meninggalkan singgasana untuk menghadapi Kreswara dan AS-LEEN."

    stop sound
    play sound "audio/sfx/chapter 4/9.suara Tension Rise.mp3" loop
    
    scene bg_kerajaan with dissolve
    
    show a_talk at Position(xalign=0.5, yalign=0.3), getar with dissolve
    a "Duryodana."
    hide a_talk

    stop sound
    play music "audio/backsound/Chapter 4/surprising_media-spatial-fantasy-455240.mp3" loop

    show dur_talk at Position(xalign=0.5, yalign=0.3), napas_berat with dissolve
    dur "Sudah menjadi kewajiban bagi makhluk fana seperti kalian"
    dur "untuk mengingat kisah kemegahan yang tertanam dalam namaku yang agung."
    dur "Dan merupakan sebuah kenistaan bagi kalian yang berani memiliki nyali"
    dur "untuk menatapku dengan mata rapuh penuh tantangan seperti itu."
    dur "Namun, jangan khawatir. Tatapan itu masih bisa kalian simpan dengan bangga"
    dur "tentu saja di bawah kakiku, agar kalian dapat menyaksikan kekuasaanku"
    dur "membentangkan suaranya hingga ke dunia yang berada di balik tempat ini."
    hide dur_talk

    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "J-jadi kau ingin menghancurkan dunia nyata juga?!"
    hide k_angrytalk

    show dur_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    dur "Menghancurkan adalah kata yang terlalu kasar, terlalu vulgar bagi kekuasaanku."
    dur "Aku lebih menyukai kata... pemimpin."
    dur "Ya, pemimpin. Sebuah sebutan yang selalu cocok untuk diriku yang hebat ini."
    dur "Tak sia-sia adikku memberiku informasi tentang dunia yang lebih luas."
    dur "Sayangnya, dia harus berakhir di tangan kotor kalian."
    dur "Namun tidak perlu khawatir kekalahan kalian akan menjadi saksi atas dendamnya."
    dur "Hanya orang-orang tak tahu diri seperti musuh-musuhku terdahulu"
    dur "yang selalu berusaha menghalangiku, orang berlima tak tahu diri itu."
    hide dur_talk

    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Kepemimpinanmu hanya akan berakhir di tanganku"
    k "Dihancurkan dan dirobek seperti kertas tak berdaya!"
    hide k_angrytalk

    show dur_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    dur "Lancang juga kau."
    hide dur_talk
    
    $ _skipping = False
    show screen radar_roh_screen(level=4)
    $ renpy.pause(2.0, hard=True)
    $ _skipping = True

    $ _skipping = False
    show screen state_roh_screen("WASPADA")
    $ renpy.pause(2.0, hard=True)
    $ _skipping = True


