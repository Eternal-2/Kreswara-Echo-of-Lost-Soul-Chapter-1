    $ boss_hp       = 3
    $ boss_attempts += 1
    $ fase1_benar   = 0
    $ fase2_benar   = 0
    $ fase3_benar   = 0

    scene bg_versus_dur with dissolve
    play sound "audio/sfx/chapter 4/8.suara glitch digital.mp3"

    stop sound

    nr "── FASE 1: Kekuatan Sejati ──"

    scene bg_istana_duryodana with dissolve
    
    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Wara, dia adalah Duryodana! Entitas terakhir yang mengunci wayang."
    a "Kesombongannya adalah tamengnya. Jawab serangannya dengan tepat!"
