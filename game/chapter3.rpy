label waktu_habis_boss_c3:
    hide screen timer_screen
    hide screen radar_roh_screen
    hide screen state_roh_screen
    hide screen soal_panel
    $ renpy.block_rollback()

    call screen kalah_boss_screen()

    if _return == "restart":
        jump boss_sengkuni_fase3_retry
    else:
        $ renpy.full_restart()

## ── Chapter 3 Ending ─────────────────────────────────────────

label chapter3_ending:
    stop music fadeout 1.5
    stop sound fadeout 1.0

    ## [BG UMUM] — Ending, bisa tampilkan sprite
    scene bg_black_and_white with fade
    play music "audio/backsound/Chapter 3/paulyudin-romantic-dreams-155789.mp3" fadein 2.0

    centered "── CHAPTER 3 SELESAI ──"
    centered "\"Jebakan di Balik Ketenangan\""

    show k_talk at Position(xalign=0.5, yalign=0.3) with fade
    k "AS-LEEN terluka. Perjalanan ini semakin berat…"
    k "tapi aku tidak akan berhenti."
    k "Aku akan menemukan bunga anggrek itu dan menyelamatkannya."
    hide k_talk

    centered "AS-LEEN terluka. Perjalanan Kreswara semakin berat."
    centered "Boss berikutnya: Duryodana — Penguasa Terakhir Dunia Hybrid."
    centered "Sampai jumpa di Chapter 4: Master Sejati."

    pause 1.5
    stop music fadeout 2.0
    scene black with Dissolve(2.0)
    pause 1.0

    $ persistent.chapter4_unlocked = True
    $ renpy.full_restart()