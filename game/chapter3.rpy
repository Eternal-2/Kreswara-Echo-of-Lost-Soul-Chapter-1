label boss_sengkuni_start:
    $ boss_hp       = 3
    $ boss_attempts += 1
    $ fase1_benar   = 0
    $ fase2_benar   = 0
    $ fase3_benar   = 0

    ## [BG UMUM] — Tampilkan sprite karakter
    scene bg_black_and_white with fade
    stop music fadeout 0.5
    play music "audio/backsound/Chapter 3/2_Fase_1.mp3" fadein 1.0

    show screen radar_roh_screen(level=2)
    pause 1.0

    centered "── FASE 1: Kenali Jebakan Data ──"

    show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
    a "Wara, dia menyerang dengan data menjebak!"
    a "Jawab benar setiap soalnya, itu satu-satunya cara menghancurkan pertahanannya!"
    hide a_talk

    show k_angrytalk at Position(xalign=0.5, yalign=0.3) with dissolve
    k "Baik. Aku tidak akan terpancing."
    hide k_angrytalk

label c3_soal_1:
    show screen soal_panel(
        nomor="1",
        tema="Python – Fungsi",
        kode="def hitung(a, b):\n    return ???\n\nprint(hitung(10, 7))  # Output: 17",
        pertanyaan="Manakah isi fungsi yang menghasilkan output 17\nsaat dipanggil dengan hitung(10, 7)?"
    )

    menu:
        "return a * b":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "UGHHH— 10 dikali 7 itu 70, bukan 17!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "Perkalian bukan jawabannya. 10 dikali 7 itu 70, bukan 17. Fokus, Wara!"
            hide a_talk
            jump c3_soal_1_cadangan

        "return a - b":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "Pengurangan?! 10 dikurangi 7 itu 3, bukan 17. Salah!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "Kurang tepat, Wara. Pengurangan menghasilkan 3, bukan 17. Kumpulkan fokusmu!"
            hide a_talk
            jump c3_soal_1_cadangan

        "return a + b":
            hide screen soal_panel
            $ fase1_benar_c3 += 1
            $ quiz_score_c3  += 1
            show screen feedback_screen("berhasil")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), getar with dissolve
            k "PENJUMLAHAN! 10 ditambah 7 sama dengan 17!"
            k "Sekarang RASAKAN INI!"
            hide k_angrytalk
            play sound "audio/backsound/Chapter 3/lordsonny-punch-a-rock-161647.mp3"
            scene bg_c3_bertemu_sengkuni with dissolve
            sk "GUH?! Tidak mungkin kau tahu…!"
            scene bg_black_and_white with dissolve
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "Bagus! Serangan pertama mengenai. Dia mulai goyah!"
            hide a_talk
            jump c3_soal_2

        "return a // b":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "Floor division?! 10 dibagi 7 itu 1. Bukan 17!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "// adalah pembagian bulat ke bawah. Hasilnya 1, bukan 17. Kumpulkan fokusmu, Wara!"
            hide a_talk
            jump c3_soal_1_cadangan

label c3_soal_1_cadangan:
    show screen soal_panel(
        nomor="CADANGAN 1",
        tema="Python – Kondisional elif",
        kode="nilai = 75\nif nilai >= 85:\n    print('A')\nelif nilai >= 70:\n    print('B')\nelse:\n    print('C')",
        pertanyaan="Apa output dari program tersebut?"
    )

    menu:
        "A":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "Nilai 75 tidak >= 85, jadi bukan A!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "Perhatikan kondisi pertama: 75 >= 85 itu False. Coba lagi!"
            hide a_talk
            jump c3_soal_1_cadangan

        "B":
            hide screen soal_panel
            $ fase1_benar_c3 += 1
            $ quiz_score_c3  += 1
            show screen feedback_screen("berhasil")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), getar with dissolve
            k "B! 75 >= 70 itu benar, jadi elif pertama yang jalan!"
            k "Fokus kembali, Sengkuni tidak akan bisa menipuku!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "Lanjutkan, Wara!"
            hide a_talk
            jump c3_soal_2

        "C":
            hide screen soal_panel
            show screen feedback_screen("salah")
            pause 1.6
            hide screen feedback_screen
            show k_angrytalk at Position(xalign=0.5, yalign=0.3), lompat_kaget with dissolve
            k "C itu untuk yang tidak memenuhi keduanya. 75 masih masuk elif!"
            hide k_angrytalk
            show a_talk at Position(xalign=0.5, yalign=0.3) with dissolve
            a "Cek lagi kondisi elif: 75 >= 70 itu benar! Perhatikan baik-baik!"
            hide a_talk
            jump c3_soal_1_cadangan

        "AB (dua baris)":
            hide screen soal_panel
            show screen feedback_screen("salah")
